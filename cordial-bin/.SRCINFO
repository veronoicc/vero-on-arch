	depends = wayland
	depends = libxkbcommon
	depends = libglvnd
	depends = pipewire
	depends = hicolor-icon-theme
	depends = deno
	optdepends = bubblewrap: kernel sandbox under the plugin runtime
	optdepends = libx11: X11 session fallback
	optdepends = libxinerama: CORDIAL_MONITOR monitor selection under X11
	optdepends = sober: its Roblox build can be imported into Cordial (Cordial downloads its own)
	provides = cordial=0.34.1

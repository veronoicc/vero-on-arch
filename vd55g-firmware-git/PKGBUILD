# Maintainer: veronoicc

pkgname=vd55g-firmware-git
_pkgname=vd55g-firmware
pkgver=r2.e519457
pkgrel=1
pkgdesc="Binary firmware for STMicroelectronics VD55G camera sensors (Surface Pro 8 IR camera)"
arch=('any')
url="https://github.com/petm5/vd55g-firmware"
license=('GPL-2.0-only')
makedepends=('git')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+https://github.com/petm5/vd55g-firmware.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd "$srcdir/$_pkgname"
  install -d "${pkgdir}/usr/lib/firmware/st"
  install -m 644 *.bin "${pkgdir}/usr/lib/firmware/st/"

  for f in *.bin; do
    ln -sf "st/$f" "${pkgdir}/usr/lib/firmware/$f"
  done
}

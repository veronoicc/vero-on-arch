# Maintainer: veronoicc

pkgname=oh-my-pi-gui
pkgver=0.9.39
pkgrel=1
pkgdesc="Desktop GUI for the omp coding agent (source build with fork runtime)"
arch=('x86_64')
url="https://github.com/nornzach/oh-my-pi-gui"
license=('MIT')
depends=(
  'electron'
)
makedepends=(
  'bun'
)
optdepends=(
  'libnotify: desktop notifications'
  'xdg-utils: opening links in external browser'
)
provides=("oh-my-pi-gui=$pkgver")
conflicts=('oh-my-pi-gui-bin')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/nornzach/oh-my-pi-gui/archive/refs/tags/v${pkgver}.tar.gz"
  "${pkgname}-sidecar-${pkgver}.deb::https://github.com/nornzach/oh-my-pi-gui/releases/download/v${pkgver}/omp_${pkgver}_amd64.deb"
  "omp-gui.sh"
  "oh-my-pi-gui.desktop"
)
sha256sums=('83a238ef8284b48d9a978de5488b580b27f034a4de61822c2203b40c9cd3a4a0'
            'b3364bd117aacaf43664299cb8a73249d469eb1c987536399c0a9137f2ab0d8d'
            'f55e55897a52ccce72729d9b8e296d46975b129457e0ae40288250957b5d6d25'
            '3d0e2464deb40a7b4c773556089fabae40e5a9058198ae10acce7aaa4d6cc70e')

prepare() {
  cd "${pkgname}-${pkgver}"
  mkdir -p resources
  ar p "${srcdir}/${pkgname}-sidecar-${pkgver}.deb" data.tar.xz | tar -Jxvf - -O ./opt/omp/resources/omp > resources/omp
  chmod +x resources/omp
}

build() {
  cd "${pkgname}-${pkgver}"
  export HOME="${srcdir}/.home"
  export BUN_INSTALL="${HOME}/.bun"
  mkdir -p "${HOME}"

  bun install --frozen-lockfile
  bun run build
}

package() {
  cd "${pkgname}-${pkgver}"

  install -dm755 "${pkgdir}/usr/lib/${pkgname}"
  cp -a out "${pkgdir}/usr/lib/${pkgname}/"
  cp -a package.json "${pkgdir}/usr/lib/${pkgname}/"

  # Bundle icon for app.dock and window identity
  install -dm755 "${pkgdir}/usr/lib/${pkgname}/resources"
  install -Dm644 resources/icon.png "${pkgdir}/usr/lib/${pkgname}/resources/icon.png"

  # Install bundled fork sidecar
  install -Dm755 resources/omp "${pkgdir}/usr/lib/${pkgname}/resources/omp"

  # Launcher binary and alias
  install -Dm755 "${srcdir}/omp-gui.sh" "${pkgdir}/usr/bin/omp-gui"
  ln -sf omp-gui "${pkgdir}/usr/bin/${pkgname}"

  # Desktop entry (single entry named Oh-My-PI)
  install -Dm644 "${srcdir}/oh-my-pi-gui.desktop" "${pkgdir}/usr/share/applications/oh-my-pi-gui.desktop"

  # Icons
  for size in 16 32 48 64 128 256 512 1024; do
    if [ -f "resources/icons/${size}x${size}.png" ]; then
      install -Dm644 "resources/icons/${size}x${size}.png" \
        "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/omp-gui.png"
    fi
  done
  if [ -f "resources/icon.svg" ]; then
    install -Dm644 resources/icon.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/omp-gui.svg"
  fi

  # License
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

# Maintainer: veronoicc

pkgname=oh-my-pi-gui-bin
pkgver=0.9.36
pkgrel=1
pkgdesc="Desktop GUI for the omp coding agent (official prebuilt release with bundled fork runtime)"
arch=('x86_64')
url="https://github.com/nornzach/oh-my-pi-gui"
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'gtk3'
  'hicolor-icon-theme'
  'libnotify'
  'libsecret'
  'libxss'
  'libxtst'
  'nss'
  'xdg-utils'
)
provides=("oh-my-pi-gui=$pkgver")
conflicts=('oh-my-pi-gui')
options=('!strip' '!debug')
source=(
  "${pkgname}-${pkgver}.deb::https://github.com/nornzach/oh-my-pi-gui/releases/download/v${pkgver}/omp_${pkgver}_amd64.deb"
  "omp-gui-bin.sh"
  "oh-my-pi-gui.desktop"
  "LICENSE-${pkgver}::https://raw.githubusercontent.com/nornzach/oh-my-pi-gui/v${pkgver}/LICENSE"
)
sha256sums=('ce8cb316a767557a7eb34199e4869e0703db8f2f4d0672b90031660307fd1c4c'
            'dac77db8f8846304394957e225b82b6540ddb7d985471e6a8dac77f580c79cb6'
            '3d0e2464deb40a7b4c773556089fabae40e5a9058198ae10acce7aaa4d6cc70e'
            '5d188bc40dacd2795be7be869092446e020866d6f897a2c7961aaa8fa179d473')

package() {
  # Extract debian data archive (preserves bundled fork omp runtime in /opt/omp/resources/omp)
  ar p "${srcdir}/${pkgname}-${pkgver}.deb" data.tar.xz | tar -Jxvf - -C "${pkgdir}"

  # Install binary launcher and compatibility symlink
  install -Dm755 "${srcdir}/omp-gui-bin.sh" "${pkgdir}/usr/bin/omp-gui"
  ln -sf omp-gui "${pkgdir}/usr/bin/oh-my-pi-gui"

  # Replace default desktop file with single properly-named Oh-My-PI desktop entry
  rm -f "${pkgdir}/usr/share/applications/omp-gui.desktop"
  install -Dm644 "${srcdir}/oh-my-pi-gui.desktop" "${pkgdir}/usr/share/applications/oh-my-pi-gui.desktop"

  # Fix sandbox permissions
  chmod 4755 "${pkgdir}/opt/omp/chrome-sandbox" 2>/dev/null || chmod 0755 "${pkgdir}/opt/omp/chrome-sandbox"

  # Remove unneeded debian doc artifacts
  rm -rf "${pkgdir}/usr/share/doc"

  # License
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

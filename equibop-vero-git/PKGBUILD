# Maintainer: creations
# Contributor: veronoicc
## Forked from vesktop-git

## options
#: ${_electron_version:=31}
: ${_install_path:=usr/share}

# basic info
_pkgname="equibop"
pkgname="$_pkgname-vero-git"
pkgdesc="Custom Discord desktop app with Equicord git and userplugins pre-bundled"
pkgver=3.3.1.r0.g83b88c5.c957307d.pdf79b92
pkgrel=1
url="https://github.com/Equicord/Equibop"
license=('GPL-3.0-only')
arch=("any")

# electron version detection
if [ -z "$_electron_version" ]; then
  _electron_version_request=$(
    curl -LSsf https://github.com/Equicord/Equibop/raw/main/package.json \
      | grep '"electron":' \
      | sed -Ee 's@^\s*"electron": "\^([0-9]+)\..*".*$@\1@' \
      | sort -rV | head -1
  )
fi

if [ -n "$_electron_version_request" ]; then
  if pacman -Si "electron${_electron_version_request:?}" > /dev/null 2>&1 || pacman -Qi "electron${_electron_version_request:?}" > /dev/null 2>&1 || pacman -Qi "electron${_electron_version_request:?}-bin" > /dev/null 2>&1; then
    : ${_electron_version:=$_electron_version_request}
  fi
fi

# continue package
depends=(
  "electron${_electron_version:-}"
)
makedepends=(
  'git'
  'bun'
  'pnpm'
  'cmake'
  'gcc'
  'nodejs'
  'npm'
)
optdepends=(
  'libnotify: Notifications'
  'xdg-utils: Open links, files, etc'
)
options=('!strip')

provides=(
  "$_pkgname"
  "$_pkgname-git"
)
conflicts=(
  "$_pkgname"
  "$_pkgname-git"
)

_pkgsrc="$_pkgname"
source=(
  "equibop"::"git+$url.git"
  "equicord"::"git+https://github.com/Equicord/Equicord.git"
  "vencord-plugins"::"git+https://github.com/veronoicc/vencord-plugins.git"
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

pkgver() {
  cd "$srcdir/equibop"
  _bop_ver=$(git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' 2>/dev/null \
    | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g')
  _cord_rev=$(git -C "$srcdir/equicord" rev-parse --short=7 HEAD 2>/dev/null || echo "0")
  _plugins_rev=$(git -C "$srcdir/vencord-plugins" rev-parse --short=7 HEAD 2>/dev/null || echo "0")
  echo "${_bop_ver}.c${_cord_rev}.p${_plugins_rev}"
}

prepare() {
  # 1. Setup userplugins in equicord
  cd "$srcdir/vencord-plugins"
  git submodule update --init --recursive

  mkdir -p "$srcdir/equicord/src/userplugins"
  cp -a "$srcdir/vencord-plugins/." "$srcdir/equicord/src/userplugins/"
  find "$srcdir/equicord/src/userplugins" -name .git -exec rm -rf {} +
  rm -rf "$srcdir/equicord/src/userplugins/.github"
  # 2. Patch equibop to use bundled equibop.asar if present
  cd "$srcdir/equibop"
  sed -i 's/bun-linux-x64-baseline/bun-linux-x64/g' scripts/build/compileArrpc.mts
  sed -i 's@: join(SESSION_DATA_DIR, "equicord.asar");@: require("fs").existsSync("/usr/share/equibop/equibop.asar") ? "/usr/share/equibop/equibop.asar" : join(SESSION_DATA_DIR, "equicord.asar");@' src/main/vencordDir.ts
}

build() {
  # 1. Build Equicord with custom userplugins
  cd "$srcdir/equicord"
  pnpm install --frozen-lockfile
  pnpm build

  # 2. Build Equibop
  cd "$srcdir/equibop"
  export SKIP_BUN_DOWNLOAD=true
  export CI=false GITHUB_ACTIONS=false
  bun install
  bun run buildLibVesktop
  bun run package:dir --publish never
}

package() {
  install -d "$pkgdir/$_install_path/$_pkgname"
  cp --reflink=auto -r "$srcdir/equibop/dist/linux-unpacked/resources/app.asar" "$pkgdir/$_install_path/$_pkgname/"
  cp --reflink=auto -r "$srcdir/equibop/dist/linux-unpacked/resources/app-update.yml" "$pkgdir/$_install_path/$_pkgname/"
  cp --reflink=auto -r "$srcdir/equibop/dist/linux-unpacked/resources/arrpc" "$pkgdir/$_install_path/$_pkgname/"

  # Bundle compiled equibop.asar containing userplugins
  install -Dm644 "$srcdir/equicord/dist/equibop.asar" "$pkgdir/$_install_path/$_pkgname/equibop.asar"

  install -Dm644 "$srcdir/equibop/static/icon.png" "$pkgdir/usr/share/pixmaps/$_pkgname.png"
  install -Dm644 "$srcdir/equibop/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"


  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$_pkgname" << END
#!/usr/bin/env sh
XDG_CONFIG_HOME="\${XDG_CONFIG_HOME:-\$HOME/.config}"
_FLAGS_FILE="\$XDG_CONFIG_HOME/${_pkgname}-flags.conf"

if [ -r "\$_FLAGS_FILE" ]; then
  _USER_FLAGS="\$(grep -v '^#' "\$_FLAGS_FILE")"
fi

if [ "\$XDG_SESSION_TYPE" = "wayland" ] && [ "\$1" = "--wayland" ]; then
  echo "Forcing Wayland"
  _WAYLAND_FLAGS="--enable-features=UseOzonePlatform,WaylandWindowDecorations,VaapiVideoDecodeLinuxGL --ozone-platform=wayland"
  shift
fi

exec electron${_electron_version:-} /$_install_path/$_pkgname/app.asar \$_USER_FLAGS \$_WAYLAND_FLAGS "\$@"
END

  install -Dm755 /dev/stdin "$pkgdir/usr/share/applications/$_pkgname.desktop" << END
[Desktop Entry]
Name=Equibop
GenericName=Internet Messenger
Comment=$pkgdesc
Type=Application
Exec=$_pkgname %U
Icon=$_pkgname
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/discord;
StartupWMClass=equibop
Keywords=discord;equicord;equibop
END
}
